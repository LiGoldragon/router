{}
[AcceptMessage ObserveRouter]
[Accepted Parked Unimplemented Error]
{
  AcceptMessage MessageIngress
  ObserveRouter RouterObservation

  Accepted MessageAcceptance
  Parked AdjudicationQueued
  Unimplemented RequestUnimplemented
  Error ErrorReport

  Recipient String
  Body String
  RouteMessageIdentifier Integer
  ChannelIdentifier String
  ErrorMessage String

  MessageKind [DirectMessage SystemNotice]
  MessageIngress {
    recipient Recipient
    body Body
    message_kind MessageKind
  }
  RouterObservation [Summary ChannelState DeliveryTrace PendingAdjudication]
  MessageAcceptance RouteMessageIdentifier
  AdjudicationQueued {
    route_message_identifier RouteMessageIdentifier
    channel_identifier ChannelIdentifier
  }

  OperationKind [AcceptMessage ObserveRouter]
  UnimplementedReason [NotInPrototypeScope ChannelMissing RouterUnavailable]
  RequestUnimplemented {
    operation_kind OperationKind
    unimplemented_reason UnimplementedReason
  }
  ErrorReport ErrorMessage
}
