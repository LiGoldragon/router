#!/usr/bin/env bash
set -euo pipefail

router="${ROUTER_BIN:?ROUTER_BIN must point at the persona-router-daemon binary}"
workspace="$(mktemp -d)"
socket="$workspace/router.sock"

"$router" daemon "$socket" >"$workspace/daemon.out" 2>"$workspace/daemon.err" &
daemon="$!"
trap 'kill "$daemon" 2>/dev/null || true' EXIT

for _ in $(seq 1 100); do
  [[ -S "$socket" ]] && break
  sleep 0.05
done
test -S "$socket"

"$router" \
  --socket "$socket" \
  '(MessageSubmission responder "router hello")' \
  >"$workspace/submission.out"

grep -Fq '(SubmissionAccepted 1)' "$workspace/submission.out"

"$router" \
  --socket "$socket" \
  '(InboxQuery responder)' \
  >"$workspace/inbox.out"

grep -Fq '(RouterInboxListing [(RouterInboxEntry 1 message-proxy "router hello")])' \
  "$workspace/inbox.out"
